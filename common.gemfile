# Shared by every service. Anything here is version-locked identically across
# all units — Bundler rejects a unit that redeclares one of these with a
# different constraint, which is what makes shared pins enforced rather than
# conventional. See prospect/DESIGN.md §6.
gem "prospect"
gem "sorbet-runtime"
gem "dynamoid", "~> 3.10"
gem "aws-sdk-dynamodb", "~> 1"
gem "cancancan", "~> 3.6"
