source "https://rubygems.org"

# No prospect and no app gems: this stack reads build/units.json, so synthesis
# needs neither Prospect's IR nor Foobara nor Dynamoid. (Prospect::Authorizer is
# still deployed, but it is fetched inside the authorizer unit's own build —
# see units/authorizer.gemfile.)

# Builds the tables from build/tables.json. Note what is NOT here: dynamoid.
# The gem stopped declaring it in 0.2.0 precisely so an infra bundle building
# from dumped data need not install the application's ORM.
gem "dynamoid-cdk-schema", "~> 0.2"

source "https://rubygems.omarqureshi.net" do
  gem "aws-cdk-lib", ">= 0.0.0.pre"
  gem "constructs", ">= 0.0.0.pre"
  gem "jsii-ruby-runtime", ">= 0.0.0.pre"
  gem "aws-cdk-asset-awscli-v1", ">= 0.0.0.pre"
  gem "aws-cdk-asset-node-proxy-agent-v6", ">= 0.0.0.pre"
  gem "aws-cdk-cloud-assembly-schema", ">= 0.0.0.pre"
end
