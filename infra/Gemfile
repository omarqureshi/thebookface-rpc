source "https://rubygems.org"

# The application's own gems, evaluated rather than restated.
#
# Synthesis loads the app to read the connector, so it must read it with EXACTLY
# the Foobara and Dynamoid the app runs. Declaring them here independently would
# resolve a second set of versions, and the plan would then be computed by a
# different Foobara than the one deployed — a skew that would show up as a
# deployment subtly disagreeing with the code, which is the hardest kind to
# diagnose.
eval_gemfile "../Gemfile"

# NOTE what is not declared here: dynamoid-cdk-schema, foobara-aws, dynamoid,
# foobara. They all arrive through the app's Gemfile above — declaring them
# again would list them twice and invite the two copies to drift apart.

# One line, as the feed documents: constructs, the jsii runtime and the asset
# gems are aws-cdk-lib's own dependencies and resolve with it. Declaring them
# separately pinned six gems where one is needed, and the `>= 0.0.0.pre` those
# carried was never necessary — the versions are datestamps like
# 0.0.0.20260804024842, which are ordinary releases, not prereleases.
#
# No constraint, so bundle install takes the newest and `bundle update
# aws-cdk-lib` adopts a later one deliberately.
gem "aws-cdk-lib", source: "https://rubygems.omarqureshi.net"
