# The optional-auth Lambda authorizer. Deliberately NOT sharing the app's
# gemfile: it serves no commands and needs none of the app's stack — no Foobara,
# no Dynamoid, no CanCanCan. Keeping it minimal keeps its cold start off the
# critical path of every authenticated request, including anonymous ones.
source "https://rubygems.org"

# The authorizer itself. foobara-aws has no runtime dependencies, so this pulls
# in nothing else.
gem "foobara-aws", path: "../../foobara-aws"
# Only the authorizer needs it, which is why foobara-aws does not depend on it.
gem "jwt", "~> 3.1"
