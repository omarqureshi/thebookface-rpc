# The optional-auth Lambda authorizer. Deliberately NOT eval_gemfile'ing
# common.gemfile: it serves no commands and needs none of the app's stack — no
# Foobara, no Dynamoid, no CanCanCan. Keeping it minimal keeps its cold start
# off the critical path of every authenticated request.
#
# One gem. It was two until the last dependency on prospect went; the authorizer
# now lives in lib/bookface_authorizer.rb, which the packager copies in.
source "https://rubygems.org"
gem "jwt", "~> 3.1"
